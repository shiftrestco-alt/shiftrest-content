<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign heading_base = settings.type_heading_font
      assign heading_font = heading_base | font_modify: 'weight', settings.heading_weight
      unless heading_font
        assign heading_font = heading_base
      endunless
      assign body_font = settings.type_body_font
    -%}
    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      :root {
        --font-heading-family: {% if heading_font.system? %}system-ui, -apple-system, sans-serif{% else %}{{ heading_font.family }}, {{ heading_font.fallback_families }}{% endif %};
        --font-heading-weight: {{ heading_font.weight }};
        --font-body-family: {% if body_font.system? %}system-ui, -apple-system, sans-serif{% else %}{{ body_font.family }}, {{ body_font.fallback_families }}{% endif %};
        --font-body-weight: {{ body_font.weight }};
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-surface-strong: {{ settings.color_surface_strong }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-border: {{ settings.color_border }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-dark: {{ settings.color_dark }};
        --color-dark-surface: {{ settings.color_dark_surface }};
        --color-star: {{ settings.color_star }};
        --page-width: {{ settings.page_width }}px;
        --radius-card: {{ settings.radius_card }}px;
      }
    {% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
