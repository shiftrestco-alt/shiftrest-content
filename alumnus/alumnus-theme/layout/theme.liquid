<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- liquid
      assign heading_base = settings.type_heading_font
      assign heading_font = heading_base | font_modify: 'weight', settings.heading_weight
      unless heading_font
        assign heading_font = heading_base
      endunless
      assign body_font = settings.type_body_font
      assign body_font_500 = body_font | font_modify: 'weight', '500'
      assign body_font_600 = body_font | font_modify: 'weight', '600'
      assign body_font_700 = body_font | font_modify: 'weight', '700'
    -%}

    {%- unless heading_font.system? and body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- unless heading_font.system? -%}
      {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- endunless -%}
    {%- unless body_font.system? -%}
      {{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_500 | font_face: font_display: 'swap' }}
      {{ body_font_600 | font_face: font_display: 'swap' }}
      {{ body_font_700 | font_face: font_display: 'swap' }}

      :root {
        --font-heading-family: {% if heading_font.system? %}system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif{% else %}{{ heading_font.family }}, {{ heading_font.fallback_families }}{% endif %};
        --font-heading-weight: {{ heading_font.weight }};
        --font-body-family: {% if body_font.system? %}system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif{% else %}{{ body_font.family }}, {{ body_font.fallback_families }}{% endif %};
        --font-body-weight: {{ body_font.weight }};

        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-surface-strong: {{ settings.color_surface_strong }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-border: {{ settings.color_border }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-dark: {{ settings.color_dark }};
        --color-dark-surface: {{ settings.color_dark_surface }};
        --color-star: {{ settings.color_star }};
        --color-success: #16A34A;

        --page-width: {{ settings.page_width }}px;
        --radius-card: {{ settings.radius_card }}px;
        --header-height: 64px;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: {{ 'sections.cart.error' | t | json }},
          copied: {{ 'general.popup.copied' | t | json }},
          days: {{ 'general.countdown.days_short' | t | json }},
          hours: {{ 'general.countdown.hours_short' | t | json }},
          minutes: {{ 'general.countdown.minutes_short' | t | json }},
          seconds: {{ 'general.countdown.seconds_short' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% section 'discount-popup' %}
  </body>
</html>
