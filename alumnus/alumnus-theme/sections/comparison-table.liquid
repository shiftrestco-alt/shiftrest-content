{%- liquid
  assign col_count = 1
  if section.settings.col_2 != blank
    assign col_count = col_count | plus: 1
  endif
  if section.settings.col_3 != blank
    assign col_count = col_count | plus: 1
  endif
-%}
<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="container container--narrow">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead reveal" data-delay="1">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="compare reveal">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ 'sections.compare.feature' | t }}</span></th>
            <th scope="col" class="is-us">{{ section.settings.col_1 | escape }}</th>
            {%- if section.settings.col_2 != blank -%}<th scope="col">{{ section.settings.col_2 | escape }}</th>{%- endif -%}
            {%- if section.settings.col_3 != blank -%}<th scope="col">{{ section.settings.col_3 | escape }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature | escape }}</th>
              {%- for i in (1..col_count) -%}
                {%- liquid
                  case i
                    when 1
                      assign value = block.settings.value_1
                    when 2
                      assign value = block.settings.value_2
                    else
                      assign value = block.settings.value_3
                  endcase
                  assign value_key = value | strip | downcase
                -%}
                <td class="{% if i == 1 %}is-us {% endif %}{% if value_key == 'yes' %}yes{% elsif value_key == 'no' %}no{% endif %}">
                  {%- if value_key == 'yes' -%}
                    {% render 'icon', name: 'check-circle' %}<span class="visually-hidden">{{ 'sections.compare.yes' | t }}</span>
                  {%- elsif value_key == 'no' -%}
                    {% render 'icon', name: 'x-circle' %}<span class="visually-hidden">{{ 'sections.compare.no' | t }}</span>
                  {%- else -%}
                    {{ value | escape }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.footnote != blank -%}<p class="plans__note">{{ section.settings.footnote | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "class": "section-compare",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Alumnus" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why not just use your phone?" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Your phone can record. It can't take the notes for you." },
    { "type": "text", "id": "col_1", "label": "Your column", "default": "Alumnus" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Phone voice memo" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Typing notes" },
    { "type": "paragraph", "content": "In each row type yes, no, or a short value. If you name a competitor brand, every claim must be true and current." },
    { "type": "text", "id": "footnote", "label": "Footnote" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "compare" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "grey"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "One-press recording" },
        { "type": "text", "id": "value_1", "label": "Your value", "default": "yes" },
        { "type": "text", "id": "value_2", "label": "Column 2 value", "default": "no" },
        { "type": "text", "id": "value_3", "label": "Column 3 value", "default": "no" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Records with one press, phone locked", "value_1": "yes", "value_2": "no", "value_3": "no" } },
        { "type": "row", "settings": { "feature": "Records phone calls without speakerphone", "value_1": "yes", "value_2": "no", "value_3": "no" } },
        { "type": "row", "settings": { "feature": "AI summary, mind map and to-dos", "value_1": "yes", "value_2": "no", "value_3": "no" } },
        { "type": "row", "settings": { "feature": "Keeps your eyes on the speaker", "value_1": "yes", "value_2": "yes", "value_3": "no" } },
        { "type": "row", "settings": { "feature": "Searchable transcript", "value_1": "yes", "value_2": "no", "value_3": "no" } },
        { "type": "row", "settings": { "feature": "Battery", "value_1": "[X] hrs, separate from your phone", "value_2": "Drains your phone", "value_3": "Laptop battery" } }
      ]
    }
  ]
}
{% endschema %}
