<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead reveal" data-delay="1">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="formats__pills reveal" role="list">
      {%- for block in section.blocks -%}
        <li class="pill" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}{{ block.settings.label | escape }}</li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_media -%}
      <div class="formats__media reveal">
        {% render 'media',
          image: section.settings.image,
          video: section.settings.video,
          ratio: '16 / 9',
          mobile_ratio: '4 / 5',
          sizes: '(min-width: 1200px) 1200px, 100vw',
          asset_id: 'IMG-17',
          title: 'One recording flowing out as clean document tiles (no readable text)',
          spec: '16:9 · 2400×1350'
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Export formats",
  "class": "section-formats",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One recording. Notes wherever you work." },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Export or share your notes in a tap." },
    { "type": "checkbox", "id": "show_media", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image (IMG-17, 16:9)" },
    { "type": "video", "id": "video", "label": "Or a looping video" },
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "format",
      "name": "Format",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "PDF" },
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "doc", "label": "Document" },
            { "value": "mail", "label": "Email" },
            { "value": "wave", "label": "Audio" },
            { "value": "download", "label": "Download" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "list-checks", "label": "Tasks" },
            { "value": "mindmap", "label": "Mind map" }
          ],
          "default": "doc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Export formats",
      "blocks": [
        { "type": "format", "settings": { "label": "PDF", "icon": "doc" } },
        { "type": "format", "settings": { "label": "Word", "icon": "doc" } },
        { "type": "format", "settings": { "label": "Email", "icon": "mail" } },
        { "type": "format", "settings": { "label": "MP3 / WAV", "icon": "wave" } },
        { "type": "format", "settings": { "label": "[More: confirm]", "icon": "download" } }
      ]
    }
  ]
}
{% endschema %}
