{%- liquid
  assign categories = section.settings.categories | split: ','
  assign has_media = section.settings.show_media
-%}
<section class="section scheme-{{ section.settings.color_scheme }}" id="{{ section.settings.anchor | default: 'faq' | handle }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <faq-tabs class="faq{% if has_media %} faq--has-media{% endif %}">
      <div>
        <div class="faq__head">
          <h2 class="h1 reveal">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
        </div>

        {%- if categories.size > 1 -%}
          <div class="faq__tabs" role="tablist" aria-label="{{ 'sections.faq.categories' | t }}">
            {%- for category in categories -%}
              {%- assign cat = category | strip -%}
              <button type="button" class="faq__tab" role="tab" data-tab="{{ cat | handle }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ cat | escape }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="accordion">
          {%- for block in section.blocks -%}
            {%- assign block_cat = block.settings.category | strip | handle -%}
            {%- assign first_cat = categories.first | strip | handle -%}
            <details data-category="{{ block_cat }}"{% if categories.size > 1 and block_cat != first_cat %} hidden{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}{% render 'icon', name: 'plus' %}</summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>

      {%- if has_media -%}
        <div class="faq__media reveal" data-delay="1">
          {% render 'media',
            image: section.settings.image,
            ratio: '4 / 5',
            sizes: '(min-width: 990px) 50vw, 100vw',
            asset_id: 'IMG-25',
            title: 'Alumnus resting on an open notebook beside a phone, soft daylight',
            spec: '4:5 · 1200×1500'
          %}
        </div>
      {%- endif -%}
    </faq-tabs>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "max_blocks": 30,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Got questions?\nWe've got answers." },
    { "type": "inline_richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "categories", "label": "Tabs", "info": "Comma separated. Each question picks one tab by name.", "default": "Product, App, Shipping, Returns" },
    { "type": "checkbox", "id": "show_media", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image (IMG-25, 4:5)" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "category", "label": "Tab", "default": "Product" },
        { "type": "text", "id": "question", "label": "Question", "default": "Do I need a subscription?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>[Confirm with supplier.]</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
