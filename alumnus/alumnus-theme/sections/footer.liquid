<footer class="footer scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="{{ routes.root_url }}">
          {{ section.settings.logo_text | default: shop.name | escape }}{%- if section.settings.show_logo_dot -%}<span class="logo-dot">.</span>{%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}<p class="muted">{{ section.settings.tagline }}</p>{%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', id: 'FooterNewsletter', class: 'stack' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,footer">
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              <div class="footer-form">
                <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
                <input id="FooterNewsletterEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
                <button type="submit" class="btn btn--primary">{{ section.settings.newsletter_button | escape }}</button>
              </div>
              {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.app_store_url != blank or section.settings.play_store_url != blank or section.settings.show_badge_placeholders -%}
          <div class="footer__badges">
            {%- if section.settings.app_store_url != blank -%}
              <a href="{{ section.settings.app_store_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'smartphone' %}{{ 'sections.footer.app_store' | t }}</a>
            {%- elsif section.settings.show_badge_placeholders -%}
              <span>[App Store badge]</span>
            {%- endif -%}
            {%- if section.settings.play_store_url != blank -%}
              <a href="{{ section.settings.play_store_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'smartphone' %}{{ 'sections.footer.play_store' | t }}</a>
            {%- elsif section.settings.show_badge_placeholders -%}
              <span>[Google Play badge]</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_follow_on_shop -%}
          <div>{{ shop | login_button: action: 'follow' }}</div>
        {%- endif -%}
      </div>

      <div class="footer__cols" style="--cols: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading | escape }}</h2>
            <ul role="list">
              {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign parts = line | strip | split: '|' -%}
                  {%- if parts.size > 0 -%}
                    {%- assign link_label = parts[0] | strip -%}
                    {%- assign link_url = parts[1] | strip | default: '#' -%}
                    {%- assign first_char = link_url | slice: 0 -%}
                    {%- if first_char == '#' and request.page_type != 'index' -%}{%- assign link_url = routes.root_url | append: link_url -%}{%- endif -%}
                    {%- if link_label != blank -%}<li><a href="{{ link_url }}">{{ link_label | escape }}</a></li>{%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name | escape }}</p>
      {%- if section.settings.show_policies -%}
        <ul class="footer__policies" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {% render 'social-icons' %}
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" role="list" style="margin-top: 20px;" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <p class="footer__wordmark" aria-hidden="true">{{ section.settings.logo_text | default: shop.name | escape }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Text logo", "default": "alumnus" },
    { "type": "checkbox", "id": "show_logo_dot", "label": "Show accent dot", "default": true },
    { "type": "inline_richtext", "id": "tagline", "label": "Tagline", "default": "Get launch deals and study tips." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true, "info": "Signups are saved as customers who accept email marketing, ready for Shopify Email." },
    { "type": "text", "id": "newsletter_button", "label": "Signup button", "default": "Join" },
    { "type": "header", "content": "App download links" },
    { "type": "url", "id": "app_store_url", "label": "App Store link" },
    { "type": "url", "id": "play_store_url", "label": "Google Play link" },
    { "type": "checkbox", "id": "show_badge_placeholders", "label": "Show badge placeholders until links are added", "default": true },
    { "type": "header", "content": "Extras" },
    { "type": "checkbox", "id": "show_follow_on_shop", "label": "Show Follow on Shop button", "default": false, "info": "Needs Shop Pay turned on." },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": false },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show large wordmark", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright name", "default": "Alumnus AI" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" } ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu (optional)" },
        { "type": "textarea", "id": "links", "label": "Links (one per line: Label | URL)", "default": "Alumnus | #buy\nApp plans | #plans\nSpecs | #specs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "links" },
        { "type": "links", "settings": { "heading": "Support", "links": "FAQ | #faq\nShipping and returns | /policies/shipping-policy\nContact | /pages/contact" } },
        { "type": "links", "settings": { "heading": "Legal", "links": "Privacy | /policies/privacy-policy\nTerms | /policies/terms-of-service\nRefunds | /policies/refund-policy" } },
        { "type": "links", "settings": { "heading": "Social", "links": "TikTok | https://www.tiktok.com/\nInstagram | https://www.instagram.com/" } }
      ]
    }
  ]
}
{% endschema %}
