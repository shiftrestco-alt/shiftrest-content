<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="guarantee" role="list" style="--count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="guarantee__item reveal" data-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <span class="icon-tile">{% render 'icon', name: block.settings.icon %}</span>
          <span class="guarantee__title">{{ block.settings.title | escape }}</span>
          {%- if block.settings.text != blank -%}<span class="guarantee__text">{{ block.settings.text }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "class": "section-guarantee",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it risk-free" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "If Alumnus doesn't make your notes better, send it back within [30] days for a full refund." },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "credit-card", "label": "Card" },
            { "value": "gift", "label": "Gift" },
            { "value": "graduation", "label": "Student" },
            { "value": "mail", "label": "Support" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free US shipping" },
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Ships in [X–X] business days with tracking." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "icon": "return", "title": "[30]-day returns", "text": "Not for you? Send it back for a full refund." } },
        { "type": "item", "settings": { "icon": "shield", "title": "[1]-year warranty", "text": "If it breaks, we replace it." } },
        { "type": "item", "settings": { "icon": "credit-card", "title": "Pay in 4 with Shop Pay", "text": "Interest-free installments at checkout." } }
      ]
    }
  ]
}
{% endschema %}
