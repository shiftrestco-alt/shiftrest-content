{%- liquid
  assign links = section.blocks
  assign use_menu = false
  if section.settings.menu != blank and section.settings.menu.links.size > 0
    assign use_menu = true
  endif
-%}
<header-bar class="header-wrapper" data-sticky>
  <header class="header">
    <div class="container header__inner">
      <button type="button" class="header__icon header__burger" aria-label="{{ 'sections.header.menu' | t }}" aria-controls="MenuDrawer" aria-expanded="false" data-menu-open>
        {% render 'icon', name: 'menu' %}
      </button>

      <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}" style="--logo-width: {{ section.settings.logo_width }}px;">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio -%}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag: width: section.settings.logo_width, height: logo_height, alt: shop.name, loading: 'eager'
          }}
        {%- else -%}
          {{ section.settings.logo_text | default: shop.name | escape }}
          {%- if section.settings.show_logo_dot -%}<span class="logo-dot">.</span>{%- endif -%}
        {%- endif -%}
      </a>

      <nav class="header__nav" aria-label="{{ 'sections.header.main_nav' | t }}">
        <ul role="list">
          {%- if use_menu -%}
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in links -%}
              {%- liquid
                assign href = block.settings.link | default: '#'
                assign first_char = href | slice: 0
                if first_char == '#' and request.page_type != 'index'
                  assign href = routes.root_url | append: href
                endif
              -%}
              <li {{ block.shopify_attributes }}><a href="{{ href }}">{{ block.settings.label | escape }}</a></li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>

      <div class="header__actions">
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <shopify-account menu="customer-account-main-menu"></shopify-account>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="header__icon" data-cart-toggle aria-label="{{ 'sections.header.cart' | t }}">
          {% render 'icon', name: 'bag' %}
          <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
        </a>
        {%- if section.settings.cta_label != blank -%}
          {%- liquid
            assign cta_href = section.settings.cta_link | default: '#buy'
            assign first_char = cta_href | slice: 0
            if first_char == '#' and request.page_type != 'index' and request.page_type != 'product'
              assign cta_href = routes.root_url | append: cta_href
            endif
          -%}
          <a href="{{ cta_href }}" class="btn btn--dark btn--sm header__cta">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </header>

  <div class="menu-drawer" id="MenuDrawer" data-menu-drawer>
    <div class="menu-drawer__overlay" data-menu-close></div>
    <div class="menu-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" tabindex="-1">
      <div class="menu-drawer__top">
        <span class="header__logo">
          {{ section.settings.logo_text | default: shop.name | escape }}{%- if section.settings.show_logo_dot -%}<span class="logo-dot">.</span>{%- endif -%}
        </span>
        <button type="button" class="icon-btn" data-menu-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', name: 'x' %}</button>
      </div>
      <nav class="menu-drawer__links" aria-label="{{ 'sections.header.main_nav' | t }}">
        {%- if use_menu -%}
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}" data-menu-close>{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for block in links -%}
            {%- liquid
              assign href = block.settings.link | default: '#'
              assign first_char = href | slice: 0
              if first_char == '#' and request.page_type != 'index'
                assign href = routes.root_url | append: href
              endif
            -%}
            <a href="{{ href }}" data-menu-close>{{ block.settings.label | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>
      <div class="menu-drawer__foot">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ cta_href }}" class="btn btn--primary btn--lg btn--block" data-menu-close>{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
        {% render 'social-icons' %}
      </div>
    </div>
  </div>
</header-bar>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Optional. Without an image the text logo below is used." },
    { "type": "range", "id": "logo_width", "label": "Logo image width", "min": 60, "max": 240, "step": 4, "unit": "px", "default": 120 },
    { "type": "text", "id": "logo_text", "label": "Text logo", "default": "alumnus" },
    { "type": "checkbox", "id": "show_logo_dot", "label": "Show accent dot after the text logo", "default": true },
    { "type": "header", "content": "Navigation" },
    { "type": "paragraph", "content": "Add Link blocks for one-page anchor links (#features, #reviews, #specs, #plans, #faq). Or pick a menu below to use a Shopify menu instead." },
    { "type": "link_list", "id": "menu", "label": "Menu (optional)" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy now" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#buy", "info": "A URL or an anchor such as #buy" },
    { "type": "checkbox", "id": "show_account", "label": "Show customer account icon", "default": true }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Features" },
        { "type": "text", "id": "link", "label": "Link", "default": "#features", "info": "A URL or an anchor such as #features" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "link", "settings": { "label": "Features", "link": "#features" } },
        { "type": "link", "settings": { "label": "Reviews", "link": "#reviews" } },
        { "type": "link", "settings": { "label": "Specs", "link": "#specs" } },
        { "type": "link", "settings": { "label": "Plans", "link": "#plans" } },
        { "type": "link", "settings": { "label": "FAQ", "link": "#faq" } }
      ]
    }
  ]
}
{% endschema %}
