{%- liquid
  assign hero_product = section.settings.product
  if hero_product == blank and product != blank
    assign hero_product = product
  endif
  if hero_product == blank
    assign hero_product = settings.main_product
  endif
  if hero_product != blank
    assign hero_variant = hero_product.selected_or_first_available_variant
  endif

  assign rating_value = ''
  assign rating_count = ''
  if hero_product != blank and hero_product.metafields.reviews.rating.value != blank
    assign rating_value = hero_product.metafields.reviews.rating.value.rating | round: 1
    assign rating_count = hero_product.metafields.reviews.rating_count.value
  endif
  if rating_value == blank and section.settings.rating_fallback != blank
    assign rating_value = section.settings.rating_fallback
  endif

  assign trust_items = section.settings.trust_items | split: '|'
  assign media_class = 'hero__media'
  if section.settings.media_width == 'full'
    assign media_class = media_class | append: ' hero__media--full'
  endif
-%}
<section class="hero section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="hero__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow reveal">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h1 class="{{ section.settings.heading_size }} reveal" data-delay="1">{{ section.settings.heading | escape }}</h1>
    </div>

    <div class="{{ media_class }} reveal" data-delay="2">
      {% render 'media',
        image: section.settings.image,
        mobile_image: section.settings.mobile_image,
        video: section.settings.video,
        ratio: '16 / 10',
        mobile_ratio: '4 / 5',
        sizes: '(min-width: 1200px) 1100px, 100vw',
        eager: true,
        asset_id: 'IMG-01 / IMG-01M',
        title: 'Hero: Alumnus snapped to the back of a phone, clean studio light',
        spec: 'Desktop 16:10 · 2400×1500 · Mobile 4:5 · 1200×1500'
      %}
    </div>

    <div class="hero__body">
      {%- if section.settings.text != blank -%}
        <p class="lead hero__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="hero__buy">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#buy' }}" class="btn btn--primary btn--lg">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.show_price and hero_variant != blank -%}
          <span class="price-inline">
            <span class="price-inline__now">{{ hero_variant.price | money }}</span>
            {%- if hero_variant.compare_at_price > hero_variant.price -%}
              <s class="price-inline__was">{{ hero_variant.compare_at_price | money }}</s>
            {%- endif -%}
          </span>
        {%- elsif section.settings.show_price and request.design_mode -%}
          <span class="price-inline muted small">{{ 'sections.hero.pick_product' | t }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_rating and rating_value != blank -%}
        {%- capture rating_text -%}
          <strong>{{ rating_value }}</strong>
          {%- if rating_count != blank %} · {{ 'general.rating.count' | t: count: rating_count }}{% elsif section.settings.rating_text != blank %} · {{ section.settings.rating_text | escape }}{% endif -%}
        {%- endcapture -%}
        {% render 'stars', rating: rating_value, text: rating_text %}
      {%- endif -%}

      {%- if section.settings.trust_items != blank -%}
        <ul class="trust-row" role="list">
          {%- for item in trust_items -%}
            {%- assign item_text = item | strip -%}
            {%- if item_text != blank -%}
              <li>{% render 'icon', name: 'check' %}{{ item_text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Alumnus AI" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your AI note-taker." },
    {
      "type": "select", "id": "heading_size", "label": "Heading size",
      "options": [ { "value": "h-display", "label": "Extra large" }, { "value": "h1", "label": "Large" } ],
      "default": "h-display"
    },
    { "type": "header", "content": "Media" },
    { "type": "paragraph", "content": "IMG-01 (desktop) and IMG-01M (mobile) from the Higgsfield prompt pack. A video replaces the image when set." },
    { "type": "image_picker", "id": "image", "label": "Image (IMG-01, 16:10)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (IMG-01M, 4:5)" },
    { "type": "video", "id": "video", "label": "Background video (optional loop)" },
    {
      "type": "select", "id": "media_width", "label": "Media width",
      "options": [ { "value": "contained", "label": "Contained" }, { "value": "full", "label": "Full page width" } ],
      "default": "contained"
    },
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Listen, don't type. One press records your lecture, meeting or call, and Alumnus turns it into notes you'll actually use." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Alumnus" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#buy", "info": "A URL or an anchor such as #buy" },
    { "type": "product", "id": "product", "label": "Product", "info": "Optional. Leave empty to use Theme settings > Product and offer > Your Alumnus product." },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "rating_fallback", "label": "Rating to show before a reviews app is connected", "info": "Leave empty to hide. Use your real average only.", "default": "[X.X]" },
    { "type": "text", "id": "rating_text", "label": "Rating text before a reviews app is connected", "default": "[X] reviews" },
    { "type": "text", "id": "trust_items", "label": "Trust line", "info": "Separate items with |", "default": "Free US shipping|[30]-day returns|[1]-year warranty" },
    { "type": "header", "content": "Section" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
