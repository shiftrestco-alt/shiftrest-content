{%- assign is_overlay = false -%}
{%- if section.settings.layout == 'overlay' -%}{%- assign is_overlay = true -%}{%- endif -%}
<section class="section banner{% if is_overlay %} banner--overlay{% endif %} scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="container">
    {%- unless is_overlay -%}
      <div class="section-head section-head--center banner__head">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead reveal" data-delay="1">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endunless -%}
    <div class="banner__frame reveal">
      {% render 'media',
        image: section.settings.image,
        mobile_image: section.settings.mobile_image,
        video: section.settings.video,
        ratio: '21 / 9',
        mobile_ratio: '4 / 5',
        sizes: '(min-width: 1200px) 1200px, 100vw',
        asset_id: 'IMG-03 / IMG-03M',
        title: 'Wide scene: Alumnus on a phone on a desk, campus window light',
        spec: 'Desktop 21:9 · 2400×1030 · Mobile 4:5 · 1200×1500'
      %}
      {%- if is_overlay -%}
        <div class="banner__copy">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "class": "section-image-banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A new kind of device for a different way of thinking." },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "No screen, no typing, no app open on your phone. Just press and talk." },
    { "type": "image_picker", "id": "image", "label": "Image (IMG-03, 21:9)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (IMG-03M, 4:5)" },
    { "type": "video", "id": "video", "label": "Video loop (optional)" },
    {
      "type": "select", "id": "layout", "label": "Text position",
      "options": [ { "value": "above", "label": "Above the image" }, { "value": "overlay", "label": "On the image" } ],
      "default": "above"
    },
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Image banner" } ]
}
{% endschema %}
