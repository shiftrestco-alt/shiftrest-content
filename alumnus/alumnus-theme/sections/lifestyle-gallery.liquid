<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="lead reveal" data-delay="1">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <carousel-slider class="carousel{% if section.blocks.size > 4 %} carousel--has-nav{% endif %}" style="--per-view: 4; --per-view-md: 2;">
      <ul class="carousel__track" role="list" data-track>
        {%- for block in section.blocks -%}
          {%- assign img_number = forloop.index | plus: 3 -%}
          {%- if img_number < 10 -%}{%- assign asset_id = 'IMG-0' | append: img_number -%}{%- else -%}{%- assign asset_id = 'IMG-' | append: img_number -%}{%- endif -%}
          <li class="life-card reveal" data-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
            {% render 'media', image: block.settings.image, ratio: '4 / 5', sizes: '(min-width: 990px) 25vw, 82vw', asset_id: asset_id, title: block.settings.placeholder_note, spec: '4:5 · 1200×1500' %}
            <div class="stack" style="--gap: 6px;">
              <h3 class="life-card__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="life-card__text">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="carousel__nav">
        <button type="button" class="carousel__btn" data-prev aria-label="{{ 'general.slider.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="carousel__btn" data-next aria-label="{{ 'general.slider.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </carousel-slider>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle gallery",
  "class": "section-lifestyle",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See Alumnus in real life" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "From lecture halls to client calls." },
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "grey"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Photo card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (4:5)" },
        { "type": "text", "id": "placeholder_note", "label": "What this photo shows", "default": "Student in a lecture hall, Alumnus on the desk" },
        { "type": "text", "id": "title", "label": "Title", "default": "In class" },
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Record the lecture, study from the summary." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifestyle gallery",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "placeholder_note": "Young professional in a meeting room, device on the table", "title": "At work", "text": "Meeting minutes and action items, done." } },
        { "type": "card", "settings": { "placeholder_note": "Person on a phone call, Alumnus snapped to the phone", "title": "On a call", "text": "Capture calls without speakerphone." } },
        { "type": "card", "settings": { "placeholder_note": "Walking outdoors talking an idea into the device", "title": "On the go", "text": "Talk through ideas, get a clean outline." } }
      ]
    }
  ]
}
{% endschema %}
