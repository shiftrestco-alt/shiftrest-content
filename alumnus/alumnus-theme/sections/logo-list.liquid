<section class="section logos scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <p class="logos__title">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
    <ul class="logos__row" role="list">
      {%- for block in section.blocks -%}
        <li class="logos__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 280 | image_tag: loading: 'lazy', alt: block.settings.name, height: 32 }}
          {%- else -%}
            <span class="logos__text">{{ block.settings.name | default: '[Logo]' | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Logo bar",
  "class": "section-logos",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Used by students and professionals at" },
    { "type": "paragraph", "content": "Only show schools, companies or press outlets where this is true. Real logos only (LOGO-01 to LOGO-05 in the prompt pack). This bar also works as an \"As seen in\" press bar." },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (SVG or transparent PNG)" },
        { "type": "text", "id": "name", "label": "Name", "default": "[Logo]", "info": "Shown as text until a logo image is uploaded, and used as alt text." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo bar",
      "blocks": [ { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" } ]
    }
  ]
}
{% endschema %}
