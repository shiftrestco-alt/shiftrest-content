<section class="section scheme-light" style="--pt: 0px; --pb: 96px;">
  <div class="container container--narrow">
    {%- form 'contact', id: 'ContactForm', class: 'stack' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" tabindex="-1" autofocus>{{ 'sections.contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="grid grid--2">
        <div class="field">
          <label for="ContactName">{{ 'sections.contact.name' | t }}</label>
          <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="field">
          <label for="ContactEmail">{{ 'sections.contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
        </div>
      </div>
      <div class="field">
        <label for="ContactOrder">{{ 'sections.contact.order' | t }}</label>
        <input id="ContactOrder" type="text" name="contact[order]" value="{{ form.order }}">
      </div>
      <div class="field">
        <label for="ContactBody">{{ 'sections.contact.message' | t }}</label>
        <textarea id="ContactBody" name="contact[body]" rows="6">{{ form.body }}</textarea>
      </div>
      <div><button type="submit" class="btn btn--primary btn--lg">{{ 'sections.contact.send' | t }}</button></div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-main-contact",
  "settings": []
}
{% endschema %}
