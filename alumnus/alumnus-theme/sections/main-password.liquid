<div class="password-main scheme-light">
  <div class="password-main__inner">
    <span class="header__logo" style="font-size: 2rem;">{{ section.settings.logo_text | default: shop.name | escape }}<span class="logo-dot">.</span></span>
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter', class: 'stack' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="footer-form" style="margin-inline: auto;">
          <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordNewsletterEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
          <button type="submit" class="btn btn--primary">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details style="margin-top: 24px;">
      <summary class="small muted" style="cursor: pointer;">{{ 'sections.password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'stack', style: 'margin-top: 12px;' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="footer-form">
          <label class="visually-hidden" for="StorePassword">{{ 'sections.password.label' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'sections.password.label' | t }}">
          <button type="submit" name="commit" class="btn btn--dark">{{ 'sections.password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Text logo", "default": "alumnus" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something smart is coming." }
  ]
}
{% endschema %}
