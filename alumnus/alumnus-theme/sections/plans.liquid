<section class="section scheme-{{ section.settings.color_scheme }}" id="{{ section.settings.anchor | default: 'plans' | handle }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead reveal" data-delay="1">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="plans" style="--plan-count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
        <div class="plan{% if block.settings.featured %} plan--featured{% endif %} reveal" data-delay="{{ forloop.index0 | modulo: 3 }}" {{ block.shopify_attributes }}>
          <div class="plan__name">
            <span>{{ block.settings.name | escape }}</span>
            {%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          </div>
          <div class="plan__price">{{ block.settings.price | escape }}{% if block.settings.period != blank %} <small>{{ block.settings.period | escape }}</small>{% endif %}</div>
          {%- if block.settings.description != blank -%}<p class="plan__desc">{{ block.settings.description }}</p>{%- endif -%}
          <ul class="plan__features" role="list">
            {%- for feature in features -%}
              {%- assign feature_text = feature | strip -%}
              {%- if feature_text != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ feature_text | escape }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if block.settings.button_label != blank -%}
            <a class="btn {% if block.settings.featured %}btn--primary{% else %}btn--outline{% endif %} btn--block" href="{{ block.settings.button_link | default: '#buy' }}">{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="plans__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Plans",
  "class": "section-plans",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "App plans" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Start free. Upgrade only if you need more. [Confirm what the app includes free with your supplier.]" },
    { "type": "inline_richtext", "id": "note", "label": "Note under the plans", "default": "No subscription is needed to record, play back and export your audio. [Confirm with supplier.]" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "plans" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Free" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "price", "label": "Price", "default": "$0" },
        { "type": "text", "id": "period", "label": "Period", "default": "forever" },
        { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Everything you need to start." },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "[X] minutes of transcription per month\nSummaries and mind maps\nExport to PDF and Word" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this plan", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "text", "id": "button_link", "label": "Button link", "default": "#buy" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Plans",
      "blocks": [
        { "type": "plan" },
        { "type": "plan", "settings": { "name": "Pro", "badge": "Most popular", "price": "[$X]", "period": "/mo", "description": "For heavy note-takers.", "features": "Everything in Free\n[More minutes]\n[Extra templates and features]", "featured": true } },
        { "type": "plan", "settings": { "name": "Teams", "price": "[Contact us]", "period": "", "description": "Clubs, firms and classes.", "features": "[Bulk orders for clubs, firms, classes]\n[Volume pricing]", "button_label": "Contact us", "button_link": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
