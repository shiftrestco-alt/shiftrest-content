{%- liquid
  assign reviews_product = section.settings.product
  if reviews_product == blank and product != blank
    assign reviews_product = product
  endif
  if reviews_product == blank
    assign reviews_product = settings.main_product
  endif
  assign avg = section.settings.average
  assign count_text = section.settings.count_text
  if reviews_product != blank and reviews_product.metafields.reviews.rating.value != blank
    assign avg = reviews_product.metafields.reviews.rating.value.rating | round: 1
    assign live_count = reviews_product.metafields.reviews.rating_count.value
    assign count_text = 'general.rating.based_on' | t: count: live_count
  endif
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign app_blocks = section.blocks | where: 'type', '@app'
-%}
<section class="section scheme-{{ section.settings.color_scheme }}" id="{{ section.settings.anchor | default: 'reviews' | handle }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="section-head section-head--center">
      <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="reviews">
      {%- if section.settings.show_summary -%}
        <div class="reviews__summary">
          <div class="reviews__score">
            <span class="reviews__avg">{{ avg | escape }}</span>
            {% render 'stars', rating: avg, text: count_text, star_size: '18px' %}
          </div>
          {%- if section.settings.write_link != blank -%}
            <a class="btn btn--outline btn--sm" href="{{ section.settings.write_link }}">{{ 'sections.reviews.write' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in review_blocks -%}
        <article class="review" {{ block.shopify_attributes }}>
          {% render 'stars', rating: block.settings.rating, star_size: '15px' %}
          <h3 class="review__title">{{ block.settings.title | escape }}</h3>
          <p class="review__text">{{ block.settings.text | escape }}</p>
          <p class="review__author">
            {{ block.settings.name | escape }}
            {%- if block.settings.verified -%} · {% render 'icon', name: 'check-circle' %} {{ 'sections.reviews.verified' | t }}{%- endif -%}
          </p>
        </article>
      {%- endfor -%}

      {%- for block in app_blocks -%}
        <div class="reviews__app" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "class": "section-reviews",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "[X]+ happy customers" },
    { "type": "product", "id": "product", "label": "Product", "info": "When a reviews app (Judge.me, Okendo, Loox, Yotpo) writes Shopify's standard rating fields, the live average and count are shown automatically." },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "text", "id": "average", "label": "Average before a reviews app is connected", "default": "[X.X]" },
    { "type": "text", "id": "count_text", "label": "Count text before a reviews app is connected", "default": "Based on [X] reviews" },
    { "type": "text", "id": "write_link", "label": "Write a review link", "info": "Your reviews app's write-a-review URL or anchor." },
    { "type": "paragraph", "content": "Add your reviews app's block here (Add block > Apps) to show the full widget. Manual Review blocks are for real reviews you collected elsewhere." },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "reviews" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "[Review title]" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "[Review text]" },
        { "type": "text", "id": "name", "label": "Name", "default": "[Name]" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ]
    }
  ]
}
{% endschema %}
