<section class="section scheme-{{ section.settings.color_scheme }}" id="{{ section.settings.anchor | default: 'specs' | handle }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <dl class="specs">
      {%- for block in section.blocks -%}
        <div class="spec" {{ block.shopify_attributes }}>
          <dt class="spec__label">{{ block.settings.label | escape }}</dt>
          <dd class="spec__value">{{ block.settings.value }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Specifications",
  "class": "section-specs",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "inline_richtext", "id": "text", "label": "Text" },
    { "type": "paragraph", "content": "Tip: store specs as product metafields, then connect each value to its metafield with the dynamic source button so the page updates from the product." },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "specs" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "grey"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Thickness" },
        { "type": "inline_richtext", "id": "value", "label": "Value", "default": "[3] mm" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Specifications",
      "blocks": [
        { "type": "spec", "settings": { "label": "Thickness", "value": "[3] mm" } },
        { "type": "spec", "settings": { "label": "Weight", "value": "[X] g" } },
        { "type": "spec", "settings": { "label": "Battery", "value": "[X] hrs recording" } },
        { "type": "spec", "settings": { "label": "Storage", "value": "[X] GB" } },
        { "type": "spec", "settings": { "label": "Audio formats", "value": "MP3, WAV" } },
        { "type": "spec", "settings": { "label": "Summary templates", "value": "17" } },
        { "type": "spec", "settings": { "label": "Languages", "value": "[X]" } },
        { "type": "spec", "settings": { "label": "Charging", "value": "Magnetic cable" } },
        { "type": "spec", "settings": { "label": "Compatibility", "value": "iPhone and Android [confirm]" } },
        { "type": "spec", "settings": { "label": "Attachment", "value": "Magnetic back, MagSafe-style [confirm]" } },
        { "type": "spec", "settings": { "label": "In the box", "value": "Recorder, magnetic cable, guide [confirm]" } },
        { "type": "spec", "settings": { "label": "Warranty", "value": "[1] year" } }
      ]
    }
  ]
}
{% endschema %}
