{%- assign slide_count = section.blocks.size -%}
<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="lead reveal" data-delay="1">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <carousel-slider class="carousel{% if slide_count > 3 %} carousel--has-nav{% endif %}" style="--per-view: 3; --per-view-md: 2;">
      <ul class="carousel__track" role="list" data-track>
        {%- for block in section.blocks -%}
          <li class="vcard" {{ block.shopify_attributes }}>
            <div class="media-wrap" style="position: relative;">
              {%- assign vid_number = forloop.index | plus: 1 -%}
              {%- assign asset_id = 'VID-0' | append: vid_number -%}
              {%- if block.settings.video != blank -%}
                <div class="media" style="--ratio: 3 / 4;">
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '900x' }}
                </div>
                <button type="button" class="vcard__sound" data-toggle-sound aria-label="{{ 'sections.video.unmute' | t }}" aria-pressed="false">
                  <span data-icon-off>{% render 'icon', name: 'sound-off' %}</span>
                  <span data-icon-on hidden>{% render 'icon', name: 'sound-on' %}</span>
                </button>
              {%- else -%}
                {% render 'media', image: block.settings.poster, ratio: '3 / 4', sizes: '(min-width: 990px) 33vw, 82vw', asset_id: asset_id, title: block.settings.placeholder_note, spec: '9:16 vertical · 1080×1920 · 15-25 s', kind: 'video', dark: true %}
              {%- endif -%}
              {%- if block.settings.tag != blank -%}<span class="badge badge--dark vcard__tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
            </div>
            <div class="vcard__meta">
              {%- if block.settings.name != blank -%}<span class="vcard__name">{{ block.settings.name | escape }}</span>{%- endif -%}
              {%- if block.settings.role != blank -%}<span class="vcard__role">{{ block.settings.role | escape }}</span>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="carousel__nav">
        <button type="button" class="carousel__btn" data-prev aria-label="{{ 'general.slider.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="carousel__btn" data-next aria-label="{{ 'general.slider.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </carousel-slider>

    {%- if section.settings.disclosure != blank -%}
      <p class="disclosure-note">{{ section.settings.disclosure | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video carousel",
  "class": "section-video-carousel",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Alumnus helps people work smarter" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "One press in class, at work and on calls." },
    { "type": "text", "id": "disclosure", "label": "Small print under the videos", "default": "Demo footage. Scenes are dramatized.", "info": "Keep this while the clips are AI-made demos (VID-02 to VID-04). Remove it once you swap in real customer videos, and add their real name and role." },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets links like #stories jump here." },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Vertical video (9:16)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image (optional)" },
        { "type": "text", "id": "placeholder_note", "label": "What this clip shows", "default": "Student records a lecture with one press" },
        { "type": "text", "id": "tag", "label": "Tag on the video", "default": "In class" },
        { "type": "text", "id": "name", "label": "Caption title", "default": "The lecture" },
        { "type": "text", "id": "role", "label": "Caption subtitle", "default": "Record → summary in under a minute" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video carousel",
      "blocks": [
        { "type": "video" },
        { "type": "video", "settings": { "placeholder_note": "Analyst snaps Alumnus to the phone for a client call", "tag": "On a call", "name": "The client call", "role": "Both sides captured, no speakerphone" } },
        { "type": "video", "settings": { "placeholder_note": "Founder reviews meeting action items in the app", "tag": "At work", "name": "The team meeting", "role": "Minutes and to-dos, done" } }
      ]
    }
  ]
}
{% endschema %}
