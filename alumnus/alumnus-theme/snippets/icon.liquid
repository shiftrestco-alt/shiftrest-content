    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="10"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/>
