{%- comment -%} Social links from Theme settings > Social media. {%- endcomment -%}
{%- liquid
  assign has_social = false
  if settings.social_tiktok_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank or settings.social_facebook_link != blank
    assign has_social = true
  endif
-%}
{%- if has_social -%}
  <ul class="social" role="list">
    {%- if settings.social_tiktok_link != blank -%}
      <li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}<span class="visually-hidden">TikTok</span></a></li>
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<span class="visually-hidden">Instagram</span></a></li>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      <li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'youtube' %}<span class="visually-hidden">YouTube</span></a></li>
    {%- endif -%}
    {%- if settings.social_twitter_link != blank -%}
      <li><a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'x-social' %}<span class="visually-hidden">X</span></a></li>
    {%- endif -%}
    {%- if settings.social_facebook_link != blank -%}
      <li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}<span class="visually-hidden">Facebook</span></a></li>
    {%- endif -%}
  </ul>
{%- endif -%}
