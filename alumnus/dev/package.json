{
  "name": "alumnus-theme-dev",
  "private": true,
  "description": "Checks and local preview for the Alumnus Shopify theme",
  "scripts": {
    "check": "node check.js ../alumnus-theme && python3 validate_json.py ../alumnus-theme",
    "preview": "node preview.js ../alumnus-theme ./preview index --product",
    "test": "node interact.js"
  },
  "dependencies": {
    "@shopify/theme-check-common": "^3.30.1",
    "@shopify/theme-check-node": "^3.30.1",
    "liquidjs": "^10.30.0",
    "playwright": "^1.56.1"
  }
}
